# Copy to .env (git-ignored). Testnet only: never put a key that holds real funds here.

MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_LOG_SPAN=100
# Deployed AgentTrustOracle (fill in after `forge script ... --broadcast`)
TRUST_ORACLE_ADDRESS=
# Deployed PasskeyReviews (forge script script/DeployPasskeyReviews.s.sol ...)
PASSKEY_REVIEWS_ADDRESS=

# Hot key the offchain poster signs postScores with. Use a fresh wallet funded with a little testnet MON.
# The deployer key itself lives in Foundry's encrypted keystore (`cast wallet import monad-deployer --interactive`).
ORACLE_PRIVATE_KEY=

# Envio HyperSync token (https://app.envio.dev/api-tokens): full-history ERC-8004 indexing on Monad mainnet/testnet
ENVIO_API_TOKEN=

# Nansen API key (https://app.nansen.ai/auth/agent-setup): wallet funding links and entity labels, Monad mainnet only
NANSEN_API_KEY=
